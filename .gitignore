# Philosophy (docs/repo_layout.md): raw data and regenerable outputs
# stay OUT of git; records, deliverables, seeds, and provenance go IN.
# Tracked on purpose: data/ (seeds + provenance), plans/ (position-plan
# deliverables), source_assignment_review.csv (the current assignment
# record — diffs show what a re-assignment changed), docs/examples/.

.env
__pycache__/
*.pyc
*.egg-info/
.venv/
.DS_Store

# Raw data never lives in git: the .h5 files are the archive, and the
# bulk nabPy filter CSVs (11 GB) were ingested long ago.
*.h5
development/inputs/nabPyStandardFilterOutputs/

# Transient staging & regenerable outputs. Committed example figures
# live in docs/examples/ instead.
fit_plots/
hitmaps/
filter_output_*.csv
bc_maps*.csv
data/TrapFilterData/
slurmoutputs/
offline_output/
fit_plots_test/
