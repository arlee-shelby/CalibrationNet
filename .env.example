# Template for .env — copy, don't rename:  cp .env.example .env
#
# .env holds real passwords and is gitignored, so this file is the only
# record in the repo of what a working install needs. Keep it in sync when
# a new variable is introduced (values here are placeholders).

# ---------------------------------------------------------------------------
# CalibrationNet itself: the `calibrationnet` schema inside the shared
# nab_db on GT PACE. The search_path option is what keeps this project's
# tables out of the rest of nab_db, so don't drop it.

# From a laptop, through the tunnel:
#   ssh -L 5432:atl1-1-01-006-17-2:5432 <you>@login-phoenix.pace.gatech.edu
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nab_db?options=-csearch_path%3Dcalibrationnet

# ON the cluster, connect straight to the host instead — no tunnel, and
# much faster for bulk ingest:
# DATABASE_URL=postgresql+psycopg://user:password@atl1-1-01-006-17-2:5432/nab_db?options=-csearch_path%3Dcalibrationnet

# ---------------------------------------------------------------------------
# Slow controls (read-only): run metadata, detector/beamline settings.
# Reached through the SSH tunnel scripts/with_sc_tunnel.sh opens; the port
# must match SC_LOCAL_PORT there (default 15432).
#   ssh -N -J <you>@analysis.sns.gov -L 15432:localhost:5432 nabreplay@bl13-replay.sns.gov
SC_DATABASE_URL=postgresql+psycopg://readonly:password@127.0.0.1:15432/Nab_SlowControl

# Motion-control archive (read-only): source-frame position readback for
# runs from 2026-07-24, which is also what run segments are derived from.
# Same server and tunnel as slow controls, different database. Optional —
# if unset it is derived from SC_DATABASE_URL by substituting `Test`.
# POSITIONS_DATABASE_URL=postgresql+psycopg://readonly:password@127.0.0.1:15432/Test

# ---------------------------------------------------------------------------
# Only needed where the trap filter is actually applied (the cluster):
# nabPy and the environment holding it. See scripts/setup_env.sh.

# Directory containing the nabPy package, if it isn't already importable.
# NABPY_PATH=/storage/home/hcoda1/4/<you>/Manitoba/pyNab/src

# Environment that scripts/apply_trap_filter.sh activates for array tasks.
# CALNET_VENV=/storage/home/hcoda1/4/<you>/Manitoba
